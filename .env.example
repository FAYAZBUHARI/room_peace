# Copy to .env.local and fill in. Never commit .env.local.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Neon pooled connection string. Required on Vercel; local-only development can omit it.
DATABASE_URL=
# Optional: pin a model (default gemini-flash-latest) and the fallback used when it is overloaded.
GEMINI_MODEL=
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest   (set to empty to disable the fallback)
